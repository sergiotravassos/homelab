# ─── Cartão de leitura ────────────────────────────────────────────────────────
#  O QUE FAZ      Descreve o sistema operativo da devbox como se fosse uma imagem de contentor.
#  PORQUE EXISTE  A devbox corre Fedora Silverblue, que é imutável: não fazes dnf install no
#                 sistema a correr. Mudas este ficheiro, reconstróis, e reinicias.
#  SE TIRARES     A devbox fica um Fedora sem toolchain — sem JDK, sem GraalVM, sem Podman.
#  ONDE APRENDER  docs/percurso.md — etapa 9, e a nota honesta sobre o Silverblue
# ──────────────────────────────────────────────────────────────────────────────
#
#  ISTO É UM CONCEITO NOVO, e é o mais estranho do repositório. Lê devagar:
#
#  Um sistema "bootc" arranca a partir de uma imagem de contentor. O sistema de
#  ficheiros é read-only. Instalar software não é um comando na máquina — é
#  editar este ficheiro, deixar o CI construir a imagem, e a VM adopta-a.
#
#  O que se ganha: a máquina é exactamente o que este ficheiro diz, sempre. E o
#  rollback é `bootc rollback` + reboot, porque a versão anterior fica lá.
#
#  O que se perde: familiaridade. Se isto te travar, um Fedora Server normal
#  serve para tudo o que a devbox faz. Diz que eu troco.

FROM quay.io/fedora/fedora-bootc:42

LABEL org.opencontainers.image.source="https://github.com/sergiotravassos/homelab"
LABEL org.opencontainers.image.description="Bancada de desenvolvimento do homelab"
LABEL org.opencontainers.image.licenses="MIT"

# ---------------------------------------------------------------------------
# Camada de sistema. So aqui entra o que precisa mesmo de estar na imagem:
# tudo o que puder viver num contentor de desenvolvimento fica em distrobox.
# ---------------------------------------------------------------------------
RUN dnf -y install \
      git git-lfs gh \
      podman podman-compose buildah skopeo \
      distrobox toolbox \
      make gcc gcc-c++ \
      zsh tmux ripgrep fd-find bat jq yq \
      openssh-server \
      qemu-guest-agent \
      java-21-openjdk-devel maven \
    && dnf clean all \
    && rm -rf /var/cache/dnf

# ---------------------------------------------------------------------------
# JetBrains Gateway precisa de um sshd estavel — e o unico servico exposto.
# ---------------------------------------------------------------------------
RUN systemctl enable sshd qemu-guest-agent

COPY etc/ /etc/

# GraalVM: instalado em /opt para nao depender do gestor de pacotes.
# A versao esta fixada de proposito — builds nativos nao gostam de surpresas.
ARG GRAALVM_VERSION=21.0.2
RUN curl -fsSL "https://github.com/graalvm/graalvm-ce-builds/releases/download/jdk-${GRAALVM_VERSION}/graalvm-community-jdk-${GRAALVM_VERSION}_linux-x64_bin.tar.gz" \
      | tar -xz -C /opt \
    && mv /opt/graalvm-community-openjdk-* /opt/graalvm \
    && /opt/graalvm/bin/native-image --version

ENV GRAALVM_HOME=/opt/graalvm
ENV PATH="/opt/graalvm/bin:${PATH}"

# ---------------------------------------------------------------------------
# NOTA: o Quarkus CLI, o oc e o tofu ficam de fora de proposito.
# Vivem no contentor distrobox de desenvolvimento, onde podem ser trocados de
# versao sem reconstruir e reiniciar a maquina inteira.
# ---------------------------------------------------------------------------

RUN bootc container lint
