# ─── Cartão de leitura ────────────────────────────────────────────────────────
#  O QUE FAZ      Acrescenta ao Bazzite o pouco que este lab precisa e ele não traz.
#  PORQUE EXISTE  O Bazzite já é uma distribuição de jogos completa. Só falta o
#                 qemu-guest-agent, sem o qual o Proxmox não desliga a VM com jeito.
#  SE TIRARES     A VM não responde a shutdown, e os perfis de memória passam a cortar-lhe
#                 a corrente em vez de a desligar.
#  ONDE APRENDER  docs/percurso.md — etapa 9
# ──────────────────────────────────────────────────────────────────────────────
#
#  O Bazzite é atómico por natureza, não por escolha minha — é assim que o
#  projecto o distribui. Aqui não havia alternativa mais simples.
#
#  `ostree container commit` no fim de cada camada: obrigatório em imagens
#  rpm-ostree, senão a camada não fica consolidada.

FROM ghcr.io/ublue-os/bazzite:latest

LABEL org.opencontainers.image.source="https://github.com/sergiotravassos/homelab"
LABEL org.opencontainers.image.description="Steam Machine do homelab"
LABEL org.opencontainers.image.licenses="MIT"

# ---------------------------------------------------------------------------
# qemu-guest-agent: sem ele o Proxmox nao consegue desligar a VM com jeito,
# e os perfis de memoria dependem de um shutdown limpo.
# ---------------------------------------------------------------------------
RUN rpm-ostree install \
      qemu-guest-agent \
      htop \
    && rpm-ostree cleanup -m \
    && ostree container commit

RUN systemctl enable qemu-guest-agent

COPY etc/ /etc/

# ---------------------------------------------------------------------------
# O Sunshine ja vem no Bazzite. Fica activado aqui para o streaming interno
# funcionar sem configuracao manual depois de cada reinstalacao.
# ---------------------------------------------------------------------------
RUN systemctl --global enable sunshine.service || true
